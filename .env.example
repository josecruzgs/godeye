# ---------------------------------------------------------------------------
# ADSPOWER — perfiles y automatización
# ---------------------------------------------------------------------------
# AdsPower es una app de escritorio y su API solo escucha en el localhost de la
# máquina donde está instalada. Por eso este valor cambia según dónde corra el
# proceso que la consulta:
#
#   En la máquina con AdsPower (tu Windows):
#     ADSPOWER_API_BASE_URL=http://local.adspower.net:50325
#
#   En el VPS: no la alcanza. Se le acerca con un túnel inverso por SSH, que
#   hace aparecer ese puerto en el localhost del servidor sin exponerlo a
#   internet — queda atado al loopback, nadie más llega:
#     ADSPOWER_API_BASE_URL=http://127.0.0.1:50325
#
# LEVANTAR EL TÚNEL — en PowerShell de la máquina con AdsPower abierto:
#
#   ssh -N -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes \
#       -R 50325:127.0.0.1:50325 godeye@177.7.53.246
#
# La ventana se queda en blanco, sin prompt y sin dejar escribir: eso es que
# está funcionando. Si aparece un prompt donde podés tipear, ese NO es el
# túnel. Al cerrar la ventana, el VPS deja de ver AdsPower.
#
# COMPROBAR — desde el VPS:
#   ss -tln | grep 50325                    → una línea con 127.0.0.1:50325
#   curl -s http://127.0.0.1:50325/status   → {"code":0,"msg":"success"}
#
# QUÉ DEPENDE DEL TÚNEL: solo lo que corre en el servidor web — sincronizar
# perfiles y grupos, iniciar/detener navegador, refrescar estado. EJECUTAR
# tareas no lo necesita: eso lo hace el worker `godeye-tasks` en la Windows,
# que habla con AdsPower directo por localhost.
ADSPOWER_API_BASE_URL=http://local.adspower.net:50325
# Solo si activaste "API key obligatoria" en AdsPower > Configuración > Avanzado
ADSPOWER_API_KEY=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/godeye

# Worker polling interval (ms)
WORKER_POLL_INTERVAL_MS=5000

# Qué mitad del worker enciende este proceso. Los dos trabajos tienen
# requisitos de máquina incompatibles: la automatización necesita AdsPower de
# escritorio en el mismo equipo, la escucha solo salida a internet. En un
# deploy real son dos procesos —VPS con WORKER_TASKS=0, tu Windows con
# WORKER_LISTENING=0— coordinados por Mongo. Ver DEPLOY.md.
# Vacías = las dos encendidas, que es lo correcto en local.
WORKER_TASKS=
WORKER_LISTENING=

# Dominio público donde vive el deploy accesible desde internet.
# Se usa SOLO para armar el texto del link en /campanas/compartir — si no
# está seteada, se arma con window.location.origin (ej. localhost cuando
# corres la app en tu máquina, que nadie más puede abrir).
# OJO: las NEXT_PUBLIC_ se inyectan en el build, no en el arranque. Cambiarla
# en el servidor no surte efecto hasta el próximo `npm run build`.
NEXT_PUBLIC_SHARE_BASE_URL=

# ---------------------------------------------------------------------------
# ESCUCHA (/scrapping) — monitoreo de menciones sobre figuras públicas
# ---------------------------------------------------------------------------
# Google News y GDELT no piden credencial: funcionan apenas creas el proyecto.
# Lo de abajo solo habilita fuentes adicionales.

# Análisis con IA: sentimiento, temas y resumen ejecutivo (Claude).
# Sin esta clave la ingesta sigue funcionando, pero las menciones quedan
# sin clasificar. Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# YouTube Data API v3 — cuota diaria gratuita.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Bright Data — la fuente de redes sociales (de pago, $1.50 por cada 1,000
# registros, con 5,000 gratis al mes). El token sale del panel de la cuenta;
# cada plataforma es un dataset distinto y necesita su propio id, que se
# copia de la página del scraper correspondiente en su marketplace.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_DATASET_X=
BRIGHTDATA_DATASET_INSTAGRAM=
BRIGHTDATA_DATASET_TIKTOK=
BRIGHTDATA_DATASET_FACEBOOK=
BRIGHTDATA_DATASET_LINKEDIN=

# Si está seteada, todo el sitio queda detrás de una pantalla de login
# (excepto /share/[token], el dashboard público) — ver src/proxy.ts.
# Déjala vacía en local: el gate solo tiene sentido en el deploy público,
# donde cualquiera con la URL vería el panel interno. Ahí es obligatoria y es
# la ÚNICA puerta del panel, así que que sea larga: el login aguanta 8
# intentos por IP cada 15 minutos, pero una contraseña corta igual se adivina.
SITE_PASSWORD=
